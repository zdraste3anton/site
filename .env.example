# Скопируйте в .env в корне проекта (рядом с package.json), если нужны переменные для CRA.
# Настройки ИИ (GigaChat и опционально DALL·E для картинки) задаются в server/.env — см. server/.env.example

# Backend API (по умолчанию слушает 3001)
# PORT=3001

# Фронтенд (опционально): полный URL API, если не используете прямой вызов localhost:3001
# REACT_APP_API_URL=http://127.0.0.1:3001
# Порт backend для dev, если отличается от 3001:
# REACT_APP_API_PORT=3001

# Прокси CRA (опционально): цель для src/setupProxy.js
# PROXY_API_TARGET=http://127.0.0.1:3001
