# Скопируйте этот файл в server/.env и замените значения на реальные.

# Команда (из папки server):  copy .env.example .env   (Windows)  или  cp .env.example .env



# Порт HTTP API

PORT=3001



# --- Обязательно: PostgreSQL для Prisma ---

# Замените USER и PASSWORD. Сначала в psql выполните: CREATE DATABASE characterforge;

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/characterforge?schema=public"



# --- Обязательно: подпись JWT ---

# Сгенерируйте длинную случайную строку (≥ 32 символов), не делитесь ею публично.

JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"



# CORS: origin фронтенда (React)

FRONTEND_URL="http://localhost:3000"



# --- GigaChat (Сбер GigaChat API) для маршрутов /api/ai/* ---

# Ключ авторизации из личного кабинета Sber Developer (Authorization: Basic …).

# Без GIGACHAT_AUTH_KEY сервер отвечает 503 JSON: GIGACHAT_NOT_CONFIGURED

GIGACHAT_AUTH_KEY=

GIGACHAT_SCOPE=GIGACHAT_API_PERS

GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1

GIGACHAT_MODEL=GigaChat

# Для локальной разработки при проблемах с TLS к API Сбера: false (в проде лучше true)

GIGACHAT_VERIFY_SSL=false

# Опционально: таймаут HTTP к GigaChat в мс (по умолчанию 120000)

# GIGACHAT_TIMEOUT_MS=120000


NODE_ENV=development

